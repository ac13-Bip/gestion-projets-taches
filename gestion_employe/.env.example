# Copier ce fichier en ".env" (à côté de manage.py) puis remplir les valeurs.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub (il est dans .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_TIME_ZONE=Africa/Casablanca
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mon-domaine.com

# --- Base de données ---
# postgresql (défaut) ou sqlite (pratique pour tester sans PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=GestionEmploye_DB
DB_USER=postgres
DB_PASSWORD=ton-mot-de-passe
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Google Gemini (génération de descriptions par IA) ---
GEMINI_API_KEY=ta-nouvelle-cle-gemini
# Optionnel : forcer un modèle précis (sinon le premier modèle « flash » disponible est utilisé)
# GEMINI_MODEL=gemini-2.5-flash
